{
  "name": "iina-llm-subtitle",
  "version": "1.0.1",
  "private": true,
  "description": "MAR-91 native subtitle track prototype for IINA",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.js",
    "build:helper": "node scripts/build-helper.js",
    "dev:link": "npm run build && node scripts/link.js",
